{
  "name": "sonoran-layer-co",
  "version": "1.0.0",
  "description": "Jekyll + Tailwind + React site for a Tucson 3D printing studio (Siteleaf-managed)",
  "scripts": {
    "build:css": "tailwindcss -i src/css/site.css -o assets/css/site.css --minify",
    "build:js": "esbuild src/js/main.jsx --bundle --minify --target=es2019 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=assets/js/app.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i src/css/site.css -o assets/css/site.css --watch",
    "watch:js": "esbuild src/js/main.jsx --bundle --sourcemap --define:process.env.NODE_ENV=\\\"development\\\" --outfile=assets/js/app.js --watch",
    "serve": "bundle exec jekyll serve --livereload",
    "dev": "npm run watch:css & npm run watch:js & npm run serve"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.4"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "private": true
}
